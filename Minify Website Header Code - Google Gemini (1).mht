.boqOnegoogleliteOgbOneGoogleBar { display: flex; justify-content: flex-end; margin-top: var(--bard-ogb-margin-top); margin-bottom: 12px; margin-inline-end: 12px; }

@media screen and (min-width: 960px) {
  .boqOnegoogleliteOgbOneGoogleBar { position: fixed; top: 0px; right: 0px; z-index: 2; }
}

.boqOnegoogleliteOgbOneGoogleBar.hide-ogb { display: none; }

