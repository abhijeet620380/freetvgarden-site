  body.sidenav-mavatar-migration-enabled .boqOnegoogleliteOgbOneGoogleBar :has(> iframe[name="account"]) { position: fixed !important; top: unset !important; left: unset !important; right: unset !important; bottom: 48px !important; inset-inline-start: 0px !important; margin-inline-start: var(--gem-sys-spacing--l) !important; margin: 0px !important; max-height: 600px !important; min-height: 420px !important; min-width: 320px !important; z-index: 989 !important; }
