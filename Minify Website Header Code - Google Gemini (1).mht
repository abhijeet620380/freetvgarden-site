.gds-extended-bullet { font-family: "Google Sans Code", monospace; font-size: 0.9375rem; font-weight: 650; letter-spacing: 0px; line-height: 1.5rem; font-variation-settings: "MONO" 1, "wght" 650; }

.gds-extended-blockquote { font-family: "Google Sans Code", monospace; font-size: 1.375rem; font-weight: 300; letter-spacing: 0px; line-height: 1.875rem; font-variation-settings: "MONO" 0, "wght" 300; font-style: italic; }

.gds-extended-caption { font-family: "Google Sans Code", monospace; font-size: 0.8125rem; font-weight: 400; letter-spacing: 0px; line-height: 1.25rem; font-variation-settings: "MONO" 0, "wght" 400; font-style: italic; }

.gds-extended-takeaway { font-family: "Google Sans Code", monospace; font-size: 1.0625rem; font-weight: 400; letter-spacing: 0px; line-height: 1.5rem; font-variation-settings: "MONO" 0, "wght" 400; font-style: italic; }

.gds-elevation-0 { box-shadow: rgba(0, 0, 0, 0.2) 0px 0px 0px 0px, rgba(0, 0, 0, 0.14) 0px 0px 0px 0px, rgba(0, 0, 0, 0.12) 0px 0px 0px 0px; }

.gds-elevation-1 { box-shadow: rgba(0, 0, 0, 0.2) 0px 2px 1px -1px, rgba(0, 0, 0, 0.14) 0px 1px 1px 0px, rgba(0, 0, 0, 0.12) 0px 1px 3px 0px; }

.gds-elevation-2 { box-shadow: rgba(0, 0, 0, 0.2) 0px 3px 3px -2px, rgba(0, 0, 0, 0.14) 0px 3px 4px 0px, rgba(0, 0, 0, 0.12) 0px 1px 8px 0px; }

.gds-elevation-3 { box-shadow: rgba(0, 0, 0, 0.2) 0px 3px 5px -1px, rgba(0, 0, 0, 0.14) 0px 6px 10px 0px, rgba(0, 0, 0, 0.12) 0px 1px 18px 0px; }

.gds-elevation-4 { box-shadow: rgba(0, 0, 0, 0.2) 0px 5px 5px -3px, rgba(0, 0, 0, 0.14) 0px 8px 10px 1px, rgba(0, 0, 0, 0.12) 0px 3px 14px 2px; }

.gds-elevation-5 { box-shadow: rgba(0, 0, 0, 0.2) 0px 7px 8px -4px, rgba(0, 0, 0, 0.14) 0px 12px 17px 2px, rgba(0, 0, 0, 0.12) 0px 5px 22px 4px; }

.gds-elevation-0-5 { box-shadow: rgba(0, 0, 0, 0.16) 0px 2px 8px -2px; }

.cdk-visually-hidden { border: 0px; clip: rect(0px, 0px, 0px, 0px); height: 1px; margin: -1px; overflow: hidden; padding: 0px; position: absolute; width: 1px; white-space: nowrap; outline: 0px; appearance: none; left: 0px; }

[dir="rtl"] .cdk-visually-hidden { left: auto; right: 0px; }

@media (pointer: fine) {
  ::-webkit-scrollbar, ::-webkit-scrollbar-corner { background: transparent; height: 12px; width: 12px; }
  ::-webkit-scrollbar-thumb { background: content-box content-box transparent; border: 2px solid transparent; border-radius: var(--gem-sys-shape--corner-full); min-height: 48px; min-width: 48px; }
  @supports not (scrollbar-color:auto) {
  :hover { will-change: scrollbar-color; }
}
  :hover::-webkit-scrollbar-thumb { background: content-box var(--gem-sys-color--surface-container-highest); }
  ::-webkit-scrollbar-thumb:active, ::-webkit-scrollbar-thumb:hover { background: content-box var(--gem-sys-color--outline-variant); }
  ::-webkit-scrollbar-button { height: 0px; width: 0px; }
  @supports not (selector(::-webkit-scrollbar)) {
  * { scrollbar-color: transparent transparent; scrollbar-gutter: auto; scrollbar-width: thin; }
  :hover { scrollbar-color: var(--gem-sys-color--surface-container-highest) transparent; }
}
