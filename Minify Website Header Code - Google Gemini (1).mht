  body.enable-lm-loading-animation .boqOnegoogleliteOgbOneGoogleBar { position: fixed; top: 0px; left: 0px; right: 0px; z-index: 2; background-color: transparent; margin-inline-end: 0px; margin-bottom: 0px; margin-top: var(--bard-ogb-margin-top); pointer-events: none; }
  body.enable-lm-loading-animation .boqOnegoogleliteOgbOneGoogleBar * { pointer-events: auto; }
}

body.has-internal-bar .boqOnegoogleliteOgbOneGoogleBar { margin-top: calc(var(--bard-ogb-margin-top) + var(--internal-bar-offset, 0px)); }

@media screen and (min-width: 960px) {
  body.has-internal-bar .boqOnegoogleliteOgbOneGoogleBar { margin-top: var(--bard-ogb-margin-top); top: var(--internal-bar-offset,0); }
}

